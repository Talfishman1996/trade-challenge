{
  "name": "tradevault",
  "version": "3.1.0",
  "description": "Mobile-first TradeVault dashboard using the 100k-pchip-v1 sizing model and fixed gross 1:1 RR.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "test": "node --test test/*.test.js",
    "check": "npm run test && npm run build",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:cloudflare": "wrangler pages deploy dist --project-name tradevault",
    "deploy:worker": "wrangler deploy --config worker/wrangler.toml",
    "deploy:all": "npm run build && npm run deploy:cloudflare"
  },
  "keywords": ["trading", "risk-management", "position-sizing", "dashboard", "react", "vite"],
  "author": "Talfishman1996",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "tailwindcss": "^4.2.0",
    "vite": "^7.3.1",
    "wrangler": "^4.83.0"
  }
}
